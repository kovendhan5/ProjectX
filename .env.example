# ProjectX Root Environment Variables
# Copy this file to .env for local development

# Environment
NODE_ENV=development

# Application URLs
API_URL=http://localhost:3001
BLOCKCHAIN_URL=http://localhost:3003
PHARMACY_PORTAL_URL=http://localhost:3002
REGULATOR_PORTAL_URL=http://localhost:3004

# Database
DATABASE_URL=postgresql://projectx_user:projectx_pass@localhost:5432/projectx_db

# Security
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3004

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_MAX=100

# Blockchain
BLOCKCHAIN_SERVICE_URL=http://blockchain:3003
BLOCKCHAIN_TIMEOUT=5000

# Docker
COMPOSE_PROJECT_NAME=projectx

