{
  "name": "project-x-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "services/*",
    "clients/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "validate": "node scripts/validate-env.js",
    "clean": "rm -rf node_modules && npm run clean --workspaces",
    "dev:api": "npm run dev --workspace=@project-x/api",
    "dev:blockchain": "npm run dev --workspace=@project-x/blockchain",
    "dev:pharmacy": "npm run dev --workspace=@project-x/pharmacy-portal",
    "dev:regulator": "npm run dev --workspace=@project-x/regulator-portal",
    "db:migrate": "cd services/api && npx prisma migrate dev",
    "db:seed": "cd services/api && npx prisma db seed",
    "db:reset": "cd services/api && npx prisma migrate reset --force",
    "db:studio": "cd services/api && npx prisma studio",
    "docker:up": "docker-compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker-compose.yml logs -f",
    "docker:prod": "docker-compose -f infrastructure/docker-compose.prod.yml up -d",
    "health": "scripts\\health-check.bat",
    "backup:db": "scripts\\backup-db.bat",
    "validate:env": "node scripts/validate-env.js"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
