# Production Environment Configuration
# Copy this file to .env for production deployment

# Environment
NODE_ENV=production

# Application URLs (Update with your domain names)
API_URL=https://api.projectx.com
BLOCKCHAIN_URL=https://blockchain.projectx.com
PHARMACY_PORTAL_URL=https://pharmacy.projectx.com
REGULATOR_PORTAL_URL=https://regulator.projectx.com

# Database Configuration
POSTGRES_USER=projectx_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=projectx_db
DATABASE_URL=postgresql://projectx_user:CHANGE_ME_IN_PRODUCTION@postgres:5432/projectx_db

# Docker Configuration
COMPOSE_PROJECT_NAME=projectx

# API Service Configuration
API_PORT=3001
API_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
API_RATE_LIMIT=100

# Blockchain Service Configuration
BLOCKCHAIN_PORT=3003

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.projectx.com
NEXT_PUBLIC_BLOCKCHAIN_URL=https://blockchain.projectx.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@projectx.com

# AWS Configuration (If using AWS services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Security
CORS_ORIGIN=https://pharmacy.projectx.com,https://regulator.projectx.com
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
